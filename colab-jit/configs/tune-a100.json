{
 "steps": 400000,
 "log_every": 100,
 "eval_every": 1000,
 "preview_every": 10000,
 "ckpt_every": 10000,
 "compile": true,
 "yield_gpu": false,
 "loader_workers": 6,
 "disk_lock": false,
 "draft_decode": true,
 "keep_outputs": true,
 "host": "colab-a100",
 "ship": false,
 "ship_gap": 75,
 "hf_repo": "benjamin-paine/imagenet-1k-128x128",
 "dataset": "hf128",
 "dataset_dir": "/datasets/hf/data",
 "dataset_size": 128,
 "hparams": {
  "SHARDS_IN_RAM": 1,
  "ALLOW_PARTIAL_IMAGENET": true,
  "IMAGE_SIZE": 128,
  "CACHE_BATCH_SIZE": 256,
  "pyramid_readouts": [
   [
    3,
    4
   ],
   [
    6,
    8
   ]
  ],
  "pyramid_weight": 1.0,
  "emb_dim": 800,
  "n_heads": 20,
  "head_size": 40,
  "num_blocks": 8,
  "lr": 0.0002
 },
 "run_type": "pixel_pyramid",
 "pyramid": true,
 "schedule": "broad15",
 "loss_weight": "clamp01",
 "selfflow": {
  "from": 3,
  "to": 6,
  "weight": 2.0,
  "teacher": "ema"
 },
 "xm_ot": {
  "seeds": 3
 },
 "cond": {
  "classes": 1000,
  "drop": 0.1,
  "preview_cfg": 3.0
 },
 "ema": 0.999,
 "z_snapshot": {
  "block": 6,
  "n": 128
 },
 "guard": {
  "step": 1000,
  "max_test": 5.0
 },
 "gen_eval": {
  "every": 50000,
  "n": 10000,
  "steps": 16,
  "sampler": "euler",
  "weights": "ema",
  "cfg": 3.0
 },
 "ckpt_keep": {
  "last": 2,
  "every": 100000
 },
 "seed": 44,
 "tune": {
  "sync_probe_gib": 0,
  "phases": [
   {
    "name": "batch",
    "seconds": 240,
    "pick": true,
    "pick_by": "throughput",
    "runs": [
     {
      "name": "b128",
      "set": {
       "hparams.CACHE_BATCH_SIZE": 128
      }
     },
     {
      "name": "b256",
      "set": {
       "hparams.CACHE_BATCH_SIZE": 256
      }
     },
     {
      "name": "b512",
      "set": {
       "hparams.CACHE_BATCH_SIZE": 512
      }
     }
    ]
   },
   {
    "name": "lr",
    "seconds": 900,
    "pick": true,
    "equal": "images",
    "runs": [
     {
      "name": "lr0.0001",
      "set": {
       "hparams.lr": 0.0001
      }
     },
     {
      "name": "lr0.0002",
      "set": {
       "hparams.lr": 0.0002
      }
     },
     {
      "name": "lr0.0004",
      "set": {
       "hparams.lr": 0.0004
      }
     }
    ]
   },
   {
    "name": "shape",
    "seconds": 1200,
    "runs": [
     {
      "name": "8x800",
      "set": {
       "hparams.num_blocks": 8,
       "hparams.emb_dim": 800,
       "hparams.n_heads": 20,
       "hparams.head_size": 40
      }
     },
     {
      "name": "12x704",
      "set": {
       "hparams.num_blocks": 12,
       "hparams.emb_dim": 704,
       "hparams.n_heads": 16,
       "hparams.head_size": 44
      }
     },
     {
      "name": "12x640",
      "set": {
       "hparams.num_blocks": 12,
       "hparams.emb_dim": 640,
       "hparams.n_heads": 16,
       "hparams.head_size": 40
      }
     },
     {
      "name": "8x1056",
      "set": {
       "hparams.num_blocks": 8,
       "hparams.emb_dim": 1056,
       "hparams.n_heads": 24,
       "hparams.head_size": 44
      }
     }
    ]
   },
   {
    "name": "res256",
    "seconds": 300,
    "runs": [
     {
      "name": "r256-b64",
      "set": {
       "hf_repo": "benjamin-paine/imagenet-1k-256x256",
       "dataset": "hf256",
       "dataset_dir": "/datasets/hf256/data",
       "dataset_size": 256,
       "hparams.IMAGE_SIZE": 256,
       "hparams.CACHE_BATCH_SIZE": 64
      }
     },
     {
      "name": "r256-b128",
      "set": {
       "hf_repo": "benjamin-paine/imagenet-1k-256x256",
       "dataset": "hf256",
       "dataset_dir": "/datasets/hf256/data",
       "dataset_size": 256,
       "hparams.IMAGE_SIZE": 256,
       "hparams.CACHE_BATCH_SIZE": 128
      }
     },
     {
      "name": "r256-b256",
      "set": {
       "hf_repo": "benjamin-paine/imagenet-1k-256x256",
       "dataset": "hf256",
       "dataset_dir": "/datasets/hf256/data",
       "dataset_size": 256,
       "hparams.IMAGE_SIZE": 256,
       "hparams.CACHE_BATCH_SIZE": 256
      }
     }
    ]
   }
  ]
 }
}
