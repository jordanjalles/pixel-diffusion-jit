   [
    3,
    4
   ],
   [
    6,
    8
   ]
  ],
  "pyramid_weight": 1.0,
  "emb_dim": 800,
  "n_heads": 20,
  "head_size": 40,
  "num_blocks": 8,
  "lr": 0.0001
 },
 "run_type": "pixel_pyramid",
