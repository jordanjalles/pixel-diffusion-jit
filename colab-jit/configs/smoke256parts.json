{
 "steps": 600,
 "log_every": 50,
 "eval_every": 100,
 "preview_every": 200,
 "ckpt_every": 200,
 "compile": true,
 "yield_gpu": false,
 "loader_workers": 8,
 "disk_lock": false,
 "draft_decode": true,
 "keep_outputs": true,
 "host": "colab-a100",
 "ship": true,
 "ship_gap": 5,
 "hf_repo": "benjamin-paine/imagenet-1k-256x256",
 "dataset": "hf256",
 "dataset_dir": "/datasets/hf/data",
 "dataset_size": 256,
 "hparams": {
  "SHARDS_IN_RAM": 1,
  "ALLOW_PARTIAL_IMAGENET": true,
  "IMAGE_SIZE": 256,
  "CACHE_BATCH_SIZE": 64,
