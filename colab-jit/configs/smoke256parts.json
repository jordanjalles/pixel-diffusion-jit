  "step": 100,
  "max_test": 5.0
 },
 "gen_eval": {
  "every": 400,
  "n": 500,
  "steps": 4,
  "sampler": "euler",
  "weights": "ema",
  "cfg": 3.0
 },
 "ckpt_keep": {
  "last": 2,
  "every": 1000000000
 },
 "seed": 44,
 "resume_ckpt": "DATA:init/smokeinit"
}
